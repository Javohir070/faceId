APP_NAME=EIdora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://localhost | Production HTTPS: https://eidora.ilmiy1.uz
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tashkent

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=olmi_db
DB_USERNAME=root
DB_PASSWORD=

# Windows/XAMPP: mysqldump papkasi (Linux serverda odatda kerak emas)
MYSQL_DUMP_BINARY_PATH=C:/xampp/mysql/bin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: true (yoki null — Laravel proxy orqali aniqlaydi)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Hikvision — IP, login, parol admin → Qurilmalar (devices jadvali) da saqlanadi
HIKVISION_CONNECT_TIMEOUT=10
HIKVISION_TIMEOUT=20
HIKVISION_WEBHOOK_SECRET=
HIKVISION_WEBHOOK_TRUST_DEVICE_IP=true
HIKVISION_WEBHOOK_HOST=127.0.0.1
HIKVISION_WEBHOOK_PORT=8000
HIKVISION_PING_ENABLED=true
HIKVISION_PING_INTERVAL=2
HIKVISION_PING_OFFLINE_AFTER_FAILURES=5
HIKVISION_EVENT_TIMEZONE=Asia/Tashkent
HIKVISION_EVENTS_PULL_ENABLED=true
HIKVISION_EVENTS_PULL_INTERVAL=15
HIKVISION_ALERT_STREAM_ENABLED=true
# Serverda true qiling: scheduler alertStream managerni o‘zi ishga tushirib, tirik ushlab turadi
HIKVISION_ALERT_STREAM_AUTOSTART=false
HIKVISION_ALERT_STREAM_TIMEOUT=0
HIKVISION_ALERT_STREAM_RECONNECT=5
# HIKVISION_WEBHOOK_URL="http://192.168.100.10:8000/api/webhooks/hikvision/events/<HIKVISION_WEBHOOK_SECRET>"

# Eski tizim API’si /api/legacy (docs/legacy-api.md). IP yoki CIDR, vergul bilan; bo‘sh bo‘lsa yopiq.
LEGACY_API_ALLOWED_IPS=
# add_employee yangi xodimga beradigan bo‘lim va ish jadvali id’si
LEGACY_API_DEPARTMENT_ID=
LEGACY_API_SCHEDULE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_EMPLOYEE_EXPIRY_WARN_DAYS=3
# Local SSL muammosi bo'lsa false qiling (antivirus/proxy)
TELEGRAM_HTTP_VERIFY=true
