APP_NAME=EIdora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://localhost | Production HTTPS: https://eidora.ilmiy1.uz
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tashkent

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=olmi_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: true (yoki null — Laravel proxy orqali aniqlaydi)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hikvision — IP, login, parol admin → Qurilmalar (devices jadvali) da saqlanadi
HIKVISION_CONNECT_TIMEOUT=10
HIKVISION_TIMEOUT=20
HIKVISION_WEBHOOK_SECRET=biocontrol-local-secret
HIKVISION_WEBHOOK_TRUST_DEVICE_IP=true
HIKVISION_WEBHOOK_HOST=127.0.0.1
HIKVISION_WEBHOOK_PORT=8000
HIKVISION_PING_ENABLED=true
HIKVISION_PING_INTERVAL=2
HIKVISION_PING_OFFLINE_AFTER_FAILURES=5
HIKVISION_EVENTS_PULL_ENABLED=true
HIKVISION_EVENTS_PULL_INTERVAL=15
HIKVISION_ALERT_STREAM_ENABLED=true
HIKVISION_ALERT_STREAM_TIMEOUT=0
HIKVISION_ALERT_STREAM_RECONNECT=5
# HIKVISION_WEBHOOK_URL="http://192.168.100.10:8000/api/webhooks/hikvision/events/biocontrol-local-secret"

