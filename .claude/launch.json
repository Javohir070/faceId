{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "composer",
      "runtimeArgs": [
        "dev"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "port": 8000
    },
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
